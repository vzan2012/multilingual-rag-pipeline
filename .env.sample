# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real secrets.

# Prisma / SQLite (see prisma.config.ts)
DATABASE_URL="file:./seed/dev.db"

# GroqCloud API - get a free key at https://console.groq.com
GROQ_API_KEY=""

# Optional - defaults to "llama-3.3-70b-versatile" if unset.
# Check https://console.groq.com/docs/models for current model IDs.
GROQ_MODEL=""

# ChromaDB connection (src/api/server.ts) - optional, these are the defaults
CHROMA_HOST="localhost"
CHROMA_PORT="8000"
CHROMA_COLLECTION="documents"

# REST API port (index.ts) - optional, defaults to 3000
PORT="3000"